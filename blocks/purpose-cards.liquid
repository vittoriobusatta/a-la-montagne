{% doc %}
  Renders a reusable editorial card grid with a heading, intro text, and three image cards.

  @example
  Add this block to any section that supports theme blocks.
{% enddoc %}

{% liquid
  assign columns_class = 'lg:grid-cols-3'
  case block.settings.columns_desktop
    when '2'
      assign columns_class = 'lg:grid-cols-2'
    when '3'
      assign columns_class = 'lg:grid-cols-3'
  endcase

  assign ratio_class = 'aspect-[7/8]'
  case block.settings.image_ratio
    when 'square'
      assign ratio_class = 'aspect-square'
    when 'portrait'
      assign ratio_class = 'aspect-[7/8]'
    when 'landscape'
      assign ratio_class = 'aspect-[4/3]'
  endcase
%}

<div
  class="w-full px-4 text-[rgb(var(--color-foreground))] sm:px-8 lg:px-12"
  style="
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="mx-auto max-w-[1600px]">
    <div class="mx-auto max-w-3xl text-center">
      {% if block.settings.heading != blank %}
        <h2 class="text-3xl font-normal leading-tight tracking-normal text-neutral-800 sm:text-4xl">
          {{ block.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if block.settings.text != blank %}
        <div class="mx-auto mt-2 max-w-2xl text-sm font-normal leading-6 tracking-normal text-neutral-600 sm:text-base">
          {{ block.settings.text }}
        </div>
      {% endif %}
    </div>

    <div class="mt-12 grid grid-cols-1 gap-4 sm:gap-5 lg:mt-14 {{ columns_class }}">
      {% for index in (1..3) %}
        {% liquid
          assign image_setting = 'image_' | append: index
          assign title_setting = 'title_' | append: index
          assign subtitle_setting = 'subtitle_' | append: index
          assign link_setting = 'link_' | append: index
          assign image = block.settings[image_setting]
          assign title = block.settings[title_setting]
          assign subtitle = block.settings[subtitle_setting]
          assign link = block.settings[link_setting]
        %}

        <div class="min-w-0 text-center">
          {% if link != blank %}
            <a class="group block overflow-hidden bg-neutral-100" href="{{ link }}">
          {% else %}
            <div class="group block overflow-hidden bg-neutral-100">
          {% endif %}
            <div class="{{ ratio_class }}">
              {% if image != blank %}
                {{
                  image
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900, 1000',
                    sizes: '(min-width: 1024px) 33vw, 100vw',
                    class: 'h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]'
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'h-full w-full text-neutral-300' }}
              {% endif %}
            </div>
          {% if link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}

          {% if title != blank %}
            <h3 class="mt-5 text-lg font-normal leading-6 tracking-normal text-neutral-900">
              {{ title | escape }}
            </h3>
          {% endif %}

          {% if subtitle != blank %}
            <p class="mt-1 text-sm font-normal leading-5 tracking-normal text-neutral-600">
              {{ subtitle | escape }}
            </p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purpose cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designing with purpose"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>In the mountains, we create cold-weather gear that focuses on material quality, protection, and balance.</p>"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Title",
      "default": "The material"
    },
    {
      "type": "text",
      "id": "subtitle_1",
      "label": "Subtitle",
      "default": "A density"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Card 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Title",
      "default": "The system"
    },
    {
      "type": "text",
      "id": "subtitle_2",
      "label": "Subtitle",
      "default": "A balance"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Card 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Title",
      "default": "The protection"
    },
    {
      "type": "text",
      "id": "subtitle_3",
      "label": "Subtitle",
      "default": "A barrier"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 92
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 104
    }
  ],
  "presets": [
    {
      "name": "Purpose cards"
    }
  ]
}
{% endschema %}
