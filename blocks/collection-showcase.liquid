{% doc %}
  Renders a reusable collection showcase with a heading, product grid, and call-to-action.

  @example
  Add this block to any section that supports theme blocks.
{% enddoc %}

{% liquid
  assign collection = block.settings.collection
  assign products_to_show = block.settings.products_to_show
  assign button_url = block.settings.button_link

  if button_url == blank
    if collection != blank
      assign button_url = collection.url
    endif
  endif

  assign grid_desktop_class = 'lg:grid-cols-4'
  case block.settings.columns_desktop
    when '2'
      assign grid_desktop_class = 'lg:grid-cols-2'
    when '3'
      assign grid_desktop_class = 'lg:grid-cols-3'
    when '4'
      assign grid_desktop_class = 'lg:grid-cols-4'
    when '5'
      assign grid_desktop_class = 'lg:grid-cols-5'
  endcase

  assign grid_mobile_class = 'grid-cols-2'
  if block.settings.columns_mobile == '1'
    assign grid_mobile_class = 'grid-cols-1'
  endif

  assign image_ratio_class = 'aspect-[4/5]'
  case block.settings.image_ratio
    when 'square'
      assign image_ratio_class = 'aspect-square'
    when 'portrait'
      assign image_ratio_class = 'aspect-[4/5]'
    when 'tall'
      assign image_ratio_class = 'aspect-[3/4]'
  endcase
%}

<div
  class="w-full px-4 text-[rgb(var(--color-foreground))] sm:px-8 lg:px-12"
  style="
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="mx-auto max-w-[1600px]">
    <div class="mx-auto max-w-3xl text-center">
      {% if block.settings.overline != blank %}
        <p class="text-xs font-normal uppercase leading-none tracking-normal text-neutral-500">
          {{ block.settings.overline | escape }}
        </p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="mt-2 text-3xl font-normal leading-tight tracking-normal text-neutral-800 sm:text-4xl">
          {{ block.settings.heading | escape }}
        </h2>
      {% endif %}
    </div>

    <div class="mt-12 grid {{ grid_mobile_class }} {{ grid_desktop_class }} gap-x-5 gap-y-10 sm:gap-x-8 lg:mt-14 lg:gap-x-10">
      {% if collection != blank %}
        {% for product in collection.products limit: products_to_show %}
          <a class="group block min-w-0" href="{{ product.url }}">
            <div class="{{ image_ratio_class }} relative flex items-center justify-center overflow-hidden bg-white">
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '320, 480, 640, 800, 900',
                    sizes: '(min-width: 1024px) 25vw, 50vw',
                    class: 'h-full w-full object-contain transition-opacity duration-500 group-hover:opacity-0'
                }}
                {% if product.images[1] != blank %}
                  {{
                    product.images[1]
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 800, 900',
                      sizes: '(min-width: 1024px) 25vw, 50vw',
                      class: 'absolute inset-0 h-full w-full object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100'
                  }}
                {% endif %}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'h-full w-full text-neutral-200' }}
              {% endif %}
            </div>

            <div class="mt-5 min-w-0 text-left">
              <h3 class="truncate text-sm font-normal uppercase leading-5 tracking-normal text-neutral-900">
                {{ product.title | escape }}
              </h3>
              <p class="mt-1 text-sm font-normal leading-5 tracking-normal text-neutral-800">
                {{ product.price | money }}
              </p>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for index in (1..4) limit: products_to_show %}
          <div class="block min-w-0">
            <div class="{{ image_ratio_class }} flex items-center justify-center overflow-hidden bg-white">
              {{ 'product-' | append: index | placeholder_svg_tag: 'h-full w-full text-neutral-200' }}
            </div>
            <div class="mt-5 min-w-0 text-left">
              <h3 class="truncate text-sm font-normal uppercase leading-5 tracking-normal text-neutral-900">
                {{ block.settings.placeholder_title | escape }}
              </h3>
              <p class="mt-1 text-sm font-normal leading-5 tracking-normal text-neutral-800">
                {{ 54000 | money }}
              </p>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if block.settings.button_label != blank %}
      <div class="mt-14 flex justify-center">
        <a
          class="inline-flex min-h-11 items-center justify-center rounded-full border border-neutral-950 px-5 text-sm font-normal leading-none tracking-normal text-neutral-950 transition-colors hover:bg-neutral-950 hover:text-white"
          href="{{ button_url | default: '#' }}"
        >
          {{ block.settings.button_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collection showcase",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "ACCESSORIES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For the Cold"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "tall",
          "label": "Tall"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "placeholder_title",
      "label": "Placeholder product title",
      "default": "Product title"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 92
    }
  ],
  "presets": [
    {
      "name": "Collection showcase"
    }
  ]
}
{% endschema %}
