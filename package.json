{
  "name": "a-la-montagne",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "shopify theme dev",
    "watch": "npx @tailwindcss/cli -i ./assets/tailwind.input.css -o ./assets/tailwind.output.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./assets/tailwind.input.css -o ./assets/tailwind.output.css",
    "dev": "npm run watch & npm run start"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.2.3",
    "tailwindcss": "^4.2.3"
  },
  "devDependencies": {
    "@shopify/cli": "3.92.1"
  }
}
